{
  "$defs": {
    "CitationPolicy": {
      "description": "Per-rule citation enforcement policy (Phase 2 Day 4).\n\n* `mode=soft` (default): citation is bonus metadata. Backward compatible \u2014\n  rules YAML without a `citation:` block falls into this branch.\n* `mode=hard`: every finding produced by this rule MUST cite a source.\n  Missing citations are flagged via `citation_missing` (warn) or by\n  lowering severity by one level (downgrade).\n* `source_filter`: when set, only chunks whose metadata.source is in this\n  list are eligible \u2014 prevents a BEP rule citing an IBC chunk by accident.",
      "properties": {
        "mode": {
          "default": "soft",
          "enum": [
            "hard",
            "soft"
          ],
          "title": "Mode",
          "type": "string"
        },
        "source_filter": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Filter"
        },
        "on_missing": {
          "default": "warn",
          "enum": [
            "warn",
            "downgrade"
          ],
          "title": "On Missing",
          "type": "string"
        }
      },
      "title": "CitationPolicy",
      "type": "object"
    },
    "ExtractionMeta": {
      "description": "v1.4 ExtractionAgent provenance attached to extracted rules.\n\nOptional \u2014 hand-authored YAML rules don't carry this. ``Rule`` instances\nproduced by the v1.4 ExtractionAgent (or the D0 Claude Desktop skill\npack workflow) populate it so the user can trace any finding back to\nthe BEP clause that justified it.\n\nFields:\n  * ``confidence`` \u2014 LLM self-reported certainty (0.0\u20131.0). Acts as\n    an automatic fixability gate: below 0.75 we force-bump to manual.\n  * ``source_text`` \u2014 exact quote from the BEP for traceability.\n  * ``source_location`` \u2014 human-readable pointer (``\"BEP \u00a71.7 page 12\"``).\n  * ``extracted_by`` \u2014 which LLM (or human) produced this rule.\n  * ``extracted_at`` \u2014 ISO-8601 timestamp of extraction.\n  * ``execution_status`` \u2014 see :data:`ExecutionStatus`. Only entries\n    with ``executable`` actually load into the runtime RuleSet; the\n    other two land in the extraction review queue with the reason\n    captured in ``status_reason``.\n  * ``notes`` \u2014 optional list of interpretation guidance from the\n    source that doesn't fit in ``description`` (measurement\n    methodology, definition clarifications, scope nuances). For\n    example, IBC \u00a71003.2 has a note explaining headroom is measured\n    \"from finished floor to underside of obstruction\" \u2014 that goes\n    here, not in the rule's description. The runtime QC engine\n    currently ignores notes; they're informational for downstream\n    custom checkers and human reviewers.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "source_text": {
          "title": "Source Text",
          "type": "string"
        },
        "source_location": {
          "default": "",
          "title": "Source Location",
          "type": "string"
        },
        "extracted_by": {
          "default": "",
          "title": "Extracted By",
          "type": "string"
        },
        "extracted_at": {
          "default": "",
          "title": "Extracted At",
          "type": "string"
        },
        "execution_status": {
          "default": "executable",
          "enum": [
            "executable",
            "needs_domain_mapping",
            "not_model_checkable"
          ],
          "title": "Execution Status",
          "type": "string"
        },
        "status_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Reason"
        },
        "notes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "confidence",
        "source_text"
      ],
      "title": "ExtractionMeta",
      "type": "object"
    },
    "GeometryRule": {
      "description": "Geometry-based check \u2014 captured for v2, not executed by current rules_engine.\n\nStores requirements that depend on 3D geometry, spatial containment, or\nlinked-file traversal. Always written with ``execution_status =\n\"not_model_checkable\"`` so the Rule Builder can persist them losslessly\nwhile the geometric evaluator registry (Tier 3 roadmap) is built.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "check_type": {
          "enum": [
            "clearance_min",
            "clearance_max",
            "spatial_containment",
            "min_spacing"
          ],
          "title": "Check Type",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "threshold_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold Mm"
        },
        "clearance_direction": {
          "anyOf": [
            {
              "enum": [
                "below",
                "above",
                "horizontal"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clearance Direction"
        },
        "reference_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Category"
        },
        "reference_source": {
          "default": "same_model",
          "enum": [
            "same_model",
            "linked_arch",
            "linked_struct",
            "linked_mep"
          ],
          "title": "Reference Source",
          "type": "string"
        },
        "spatial_filter": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeometryRuleSpatialFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "severity_tag": {
          "default": "geometric_violation",
          "title": "Severity Tag",
          "type": "string"
        },
        "execution_status": {
          "default": "not_model_checkable",
          "enum": [
            "executable",
            "needs_domain_mapping",
            "not_model_checkable"
          ],
          "title": "Execution Status",
          "type": "string"
        },
        "view_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "View Id"
        },
        "notes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "category",
        "check_type",
        "description"
      ],
      "title": "GeometryRule",
      "type": "object"
    },
