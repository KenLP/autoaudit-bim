# --- Rule Builder (Streamlit, optional) ---
# Used only by the Rule Builder tab (NL → rule draft via Claude Haiku).
# Not needed for --check / --apply / --run / --run-revit (runtime is LLM-free).
# ANTHROPIC_API_KEY=sk-ant-...

# --- acc-forma-mcp-server subprocess ---
#
# We launch the MCP server with cwd set to its folder so that its own .env
# (APS_*, SSA_*, FORMA_*) loads via dotenv. The orchestrator never sees secrets.
#
# Auto-detect priority (when FORMA_MCP_SERVER_CWD is blank):
#   1. vendor/forma-mcp/forma-mcp.exe  — SEA standalone build, no Node.js needed.
#        Fetch it once with:  pwsh scripts/fetch-forma-mcp.ps1
#        Then fill vendor/forma-mcp/.env (copy from .env.example there).
#   2. vendor/forma-mcp/dist/index.js  — Node bridge fallback (requires Node.js).
#
# Override below only to point at a custom server checkout.
FORMA_MCP_SERVER_CMD=node
FORMA_MCP_SERVER_ARGS=dist/index.js
FORMA_MCP_SERVER_CWD=

# --- Revit connection ---
#
# Two modes (auto-selected by make_revit_client()):
#
#   HTTP direct (default when no Node bridge is configured):
#     Calls the RevitMCPServer addin at 127.0.0.1:{port} directly.
#     No Node.js required. Auth token auto-read from:
#       %APPDATA%\Autodesk\Revit\Addins\{version}\revit-mcp-token.txt
#     Set REVIT_MCP_USE_HTTP=true to force this mode even when a bridge is present.
#
#   MCP stdio bridge (legacy, when REVIT_MCP_SERVER_CWD is set):
#     Spawns the Node revit-mcp-server bridge subprocess.
#     Requires Node.js + revit-mcp-server built at CWD.
#
# Uncomment and set CWD only if you want the Node bridge:
# REVIT_MCP_SERVER_CMD=node
# REVIT_MCP_SERVER_ARGS=dist/index.js
# REVIT_MCP_SERVER_CWD=C:\Users\Ken\Projects\RevitMCPServer\src\McpServer
#
# Common overrides (both modes):
# REVIT_MCP_USE_HTTP=true
# REVIT_MCP_PORT=7891
# REVIT_MCP_VERSION=2026
# Leave unset to auto-load the addin's token file from %APPDATA%.
# The addin always requires the bearer token — auth cannot be disabled.
# REVIT_MCP_AUTH_TOKEN=
# DEMO_REVIT_PROJECT_PATH=D:\Revit files\R26_Snowdon Towers Sample Architectural.rvt

# --- ACC sandbox for the MVP demo ---

# DM-format IDs (b.* prefix) — used if you ever call admin/dm tools
DEMO_HUB_ID=b.00000000-0000-0000-0000-000000000003
DEMO_PROJECT_ID=b.00000000-0000-0000-0000-000000000001

# AECDM-format IDs (urn:adsk:*) — used by Query Agent in MVP scenario
DEMO_AECDM_HUB_ID=urn:adsk.ace:prod.scope:00000000-0000-0000-0000-000000000004
DEMO_AECDM_PROJECT_ID=urn:adsk.workspace:prod.project:00000000-0000-0000-0000-000000000002

# The Revit model under test: R27_Pacific Continental Residence Sample.rvt
# 30 Rooms, all missing Department + Occupancy — ideal MVP fodder.
DEMO_ELEMENT_GROUP_ID=YWVjZH5tdGFsbjFmcDd4dVZBUU9TSHNkR2oxX0wyQ344YTU5YWUzMS1iZTM2LTUyNjctOTRhYy1lMGFlZmExMzdkNGI

# Default Issue subtype for --apply. The first auto-discovered subtype
# ("Design/Design") is inactive in this project, so we pin to "Quality/Quality"
# which is semantically correct for missing-parameter findings.
DEMO_ISSUE_SUBTYPE_ID=00000000-0000-0000-0000-000000000005

# --- Optional: remote rule sync ---
# URL to a JSON manifest. If set, the Streamlit app fetches and caches rule
# YAMLs into config/ at startup (TTL 5 minutes). Lets teams push rule updates
# without reinstalling. Manifest format:
#   {"rules": [{"scenario": "my_rules", "url": "https://raw.github.com/.../rules.my_rules.yaml"}]}
# RULES_REMOTE_MANIFEST=
