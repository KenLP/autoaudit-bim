    "RuleRemediation": {
      "description": "How DesignAgent should act on a finding produced by this rule.\n\n* ``action=create_acc_issue`` (default): the Phase 1 path \u2014 DesignAgent\n  builds an ACC Issue via Forma MCP. Used for ``fixability=manual``\n  cases where a human (or another model) must judge the fix.\n* ``action=set_parameter``: write a single parameter via Revit MCP.\n  Pair with ``target_parameter`` (defaults to the rule's parameter) and\n  a ``new_value_strategy``. ``inferred`` reuses the existing autofill\n  pipeline; ``fixed`` writes ``new_value`` verbatim; ``next_available``\n  lets DesignAgent compute a unique replacement (e.g. for duplicate\n  room numbers).\n* ``action=rename_element``: write the element's Name parameter.\n\n``comments_template`` \u2014 when set, DesignAgent will also tag the room's\nComments parameter so the audit trail is visible in Revit. Supports\n``{value}`` / ``{old_value}`` / ``{new_value}`` / ``{rule_id}``\nplaceholders.",
      "properties": {
        "action": {
          "default": "create_acc_issue",
          "enum": [
            "create_acc_issue",
            "set_parameter",
            "rename_element"
          ],
          "title": "Action",
          "type": "string"
        },
        "target_parameter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Parameter"
        },
        "new_value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "New Value"
        },
        "new_value_strategy": {
          "default": "inferred",
          "enum": [
            "fixed",
            "inferred",
            "next_available"
          ],
          "title": "New Value Strategy",
          "type": "string"
        },
        "comments_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comments Template"
        },
        "target": {
          "default": "instance",
          "enum": [
            "instance",
            "type",
            "family",
            "auto"
          ],
          "title": "Target",
          "type": "string"
        }
      },
      "title": "RuleRemediation",
      "type": "object"
    },
    "RuleScopeFilter": {
      "description": "v1.4-K10: universal 'applies to' filter for a parameter rule.\n\nThe rule only evaluates an element when ``element.params[param]`` matches\n``pattern`` (regex search). Out-of-scope elements quietly pass. This makes\nthe conditional gate a first-class dimension of ANY check (Solibri's\n'applicable components') rather than a numeric_min-only variant.",
      "properties": {
        "param": {
          "title": "Param",
          "type": "string"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        }
      },
      "required": [
        "param",
        "pattern"
      ],
      "title": "RuleScopeFilter",
      "type": "object"
    }
  },
