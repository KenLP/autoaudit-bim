# forma-mcp.exe environment — copy to `.env` in this same folder.
#
# The SEA executable (forma-mcp.exe) loads this file via dotenv at startup,
# from its own directory. The orchestrator NEVER sees these secrets — it just
# launches the exe with cwd = this folder.
#
# The Setup tab "Forma / APS credentials" wizard writes the APS_* / SSA_* keys
# below into `.env` for you. Fill manually only if you prefer not to use the UI.

# ── APS app credentials (required) ──────────────────────────────────────────
APS_CLIENT_ID=
APS_CLIENT_SECRET=

# Auth mode: ssa (Service Account, default) | 2lo
APS_AUTH_MODE=ssa
# Region: US (default) | EMEA | AUS
APS_REGION=US

# ── SSA credentials (required when APS_AUTH_MODE=ssa) ────────────────────────
SSA_ID=
SSA_KEY_ID=
# Absolute path to the SSA private key .pem file
SSA_KEY_PATH=

# ── Optional safety / persistence (sensible defaults shown) ─────────────────
# FORMA_MUTATION_MODE=preview_required
# FORMA_READONLY=false
# FORMA_PERSISTENCE_MODE=memory     # set to sqlite for durable approval tokens
# LOG_LEVEL=info
